#!/usr/bin/env php
<?php

require __DIR__ . '/../vendor/autoload.php';

use Symfony\Component\Console\Application;
use Noctalys\Cli\Command\InitCommand;
use Noctalys\Cli\Command\TestCommand;
use Noctalys\Cli\Command\MakeCommand\PageCommand;
use Noctalys\Cli\Command\MakeCommand\LayoutCommand;

$app = new Application('Noctalys CLI', '0.1.0');

$app->addCommands([
    new InitCommand(),
    new PageCommand(),
    new LayoutCommand()
]);

$app->run();
